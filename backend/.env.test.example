# Example .env.test file for Authentico backend tests
# Copy this file to .env.test and fill in the values with your test credentials

# Encryption
MASTER_KEY_SECRET=32_character_master_key_for_aes_256

# Blockchain
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your_infura_key
SPONSOR_WALLET_PRIVATE_KEY=your_private_key_for_test_wallet
CONTRACT_ADDRESS=0xYourContractAddressForTesting
SEPOLIA_CHAIN_ID=11155111
ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddress

# IPFS/Pinata
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_GATEWAY_URL=your_pinata_gateway_url
GATEWAY_URL=your_pinata_gateway_url
PINATA_JWT=your_pinata_jwt_token

# Frontend and Email
FRONTEND_URL=https://your-test-frontend-url.com
EMAIL_SERVICE=test
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test_email_password

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY={"privateKey": "your-private-key-content"}
