{
  "name": "authentico",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "minimal-hardhat"
  ],
  "scripts": {
    "dev": "node scripts/validate-env.js development && concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "start": "npm run dev",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start --workspace=backend",
    "build": "node scripts/validate-env.js production && npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:backend": "npm test --workspace=backend",
    "test:frontend": "npm test --workspace=frontend",
    "cypress:open": "npm run cypress:open --workspace=frontend",
    "cypress:run": "npm run cypress:run --workspace=frontend",
    "install:all": "npm install",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "validate:env": "node scripts/validate-env.js",
    "validate:env:dev": "node scripts/validate-env.js development",
    "validate:env:prod": "node scripts/validate-env.js production",
    "setup:env": "node scripts/setup-env.js",
    "setup:env:dev": "node scripts/setup-env.js development",
    "setup:env:prod": "node scripts/setup-env.js production",
    "seed:verified-orgs": "node scripts/seed-verified-organizations.js",
    "setup:firebase-env": "node scripts/setup-firebase-env.js",
    "generate:master-key": "node scripts/generate-master-key.js",
    "generate:fixed-master-key": "node scripts/generate-fixed-master-key.js",
    "deploy": "powershell -File scripts/deploy.ps1",
    "deploy:vercel": "powershell -File scripts/deploy.ps1 -Environment prod -Target vercel -Build -Deploy",
    "deploy:render": "powershell -File scripts/deploy.ps1 -Environment prod -Target render -Build",
    "deploy:docker": "powershell -File scripts/deploy.ps1 -Environment prod -Target docker -Build -Deploy",
    "deploy:build": "powershell -File scripts/deploy.ps1 -Environment prod -Build",
    "install:postcss-deps": "node scripts/install-postcss-deps.js",
    "fix:dependencies": "node scripts/fix-dependency-conflicts.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "verify:deployment:config": "node scripts/verify-deployment-config.js",
    "test:verify-links": "node scripts/test-verify-links.js",
    "prepare:deploy": "npm run validate:env:prod && npm run install:postcss-deps && npm run fix:dependencies && npm run verify:deployment && npm run verify:deployment:config && npm run build"
  },
  "devDependencies": {
    "@radix-ui/react-toast": "^1.2.11",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.2",
    "@types/tailwindcss": "^3.0.11",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "concurrently": "^8.2.0",
    "cypress-file-upload": "^5.0.8",
    "dotenv": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^7.1.4",
    "postcss": "^8.5.2",
    "prettier": "^2.8.8",
    "tailwindcss": "^4.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@babel/preset-env": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "@babel/preset-typescript": "^7.25.7",
    "@mui/material": "^6.4.3",
    "@next/font": "^14.2.15",
    "@radix-ui/react-tabs": "^1.1.4",
    "axios": "^1.8.3",
    "babel-jest": "^29.7.0",
    "client-only": "^0.0.1",
    "ethers": "5.7.2",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "helmet": "^8.1.0",
    "pinata": "^2.2.0",
    "qrcode.react": "^4.2.0",
    "rate-limiter-flexible": "^7.0.0",
    "react-cookie": "^8.0.1",
    "react-cookies": "^0.1.1",
    "server-only": "^0.0.1",
    "util": "^0.12.5",
    "uuid": "^11.1.0"
  }
}
