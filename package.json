{
  "name": "authentico",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/*",
    "smart-contracts",
    "test-scripts"
  ],
  "scripts": {
    "dev": "node scripts/validate-env.js development && concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:smart-contracts\"",
    "start": "npm run dev",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:smart-contracts": "npm run compile --workspace=smart-contracts",
    "build": "node scripts/validate-env.js production && npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "install:all": "npm install",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "validate:env": "node scripts/validate-env.js",
    "validate:env:dev": "node scripts/validate-env.js development",
    "validate:env:prod": "node scripts/validate-env.js production",
    "setup:env": "node scripts/setup-env.js",
    "setup:env:dev": "node scripts/setup-env.js development",
    "setup:env:prod": "node scripts/setup-env.js production",
    "test:verify-env": "npm run verify-env --workspace=test-scripts",
    "test:auth": "npm run test:auth --workspace=test-scripts",
    "test:document": "npm run test:document --workspace=test-scripts",
    "test:all": "npm run test --workspace=test-scripts",
    "seed:verified-orgs": "node scripts/seed-verified-organizations.js",
    "test:verified-org-upload": "node test-scripts/test-verified-org-upload.js",
    "setup:firebase-env": "node scripts/setup-firebase-env.js",
    "generate:master-key": "node scripts/generate-master-key.js",
    "generate:fixed-master-key": "node scripts/generate-fixed-master-key.js",
    "deploy": "powershell -File scripts/deploy.ps1",
    "deploy:vercel": "powershell -File scripts/deploy.ps1 -Environment prod -Target vercel -Build -Deploy",
    "deploy:render": "powershell -File scripts/deploy.ps1 -Environment prod -Target render -Build",
    "deploy:docker": "powershell -File scripts/deploy.ps1 -Environment prod -Target docker -Build -Deploy",
    "deploy:build": "powershell -File scripts/deploy.ps1 -Environment prod -Build",
    "install:postcss-deps": "node scripts/install-postcss-deps.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "prepare:deploy": "npm run validate:env:prod && npm run install:postcss-deps && npm run verify:deployment && npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.0",
    "dotenv": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^7.1.4",
    "postcss": "^8.5.2",
    "prettier": "^2.8.8",
    "tailwindcss": "^4.0.6",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@babel/preset-env": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "@babel/preset-typescript": "^7.25.7",
    "@mui/material": "^6.4.3",
    "@next/font": "^14.2.15",
    "@radix-ui/react-tabs": "^1.1.4",
    "axios": "^1.8.3",
    "babel-jest": "^29.7.0",
    "client-only": "^0.0.1",
    "ethers": "5.7.2",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "pinata": "^2.2.0",
    "qrcode.react": "^4.2.0",
    "react-cookie": "^8.0.1",
    "react-cookies": "^0.1.1",
    "server-only": "^0.0.1",
    "util": "^0.12.5",
    "uuid": "^11.1.0"
  }
}
