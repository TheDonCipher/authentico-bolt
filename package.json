{
  "name": "authentico",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/*",
    "smart-contracts"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:smart-contracts\"",
    "start": "npm run dev",  
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "concurrently \"npm run start:dev --workspace=backend/document-service\" \"npm run start:dev --workspace=backend/verification-service\" \"npm run start:dev --workspace=backend/user-service\"",
    "dev:smart-contracts": "npm run compile --workspace=smart-contracts",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^7.1.4",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@babel/preset-env": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "@babel/preset-typescript": "^7.25.7",
    "babel-jest": "^29.7.0",
    "util": "^0.12.5"
  }
}
