{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/*"]
    },
    "outDir": "dist",
    "noEmit": true,
    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "exclude": [
    "node_modules",
    "**/*.js",
    "**/*.mjs",
    "frontend/lib/*.js",
    "backend/lib/*.js",
    "frontend/cypress/**/*.js",
    "frontend/next.config.mjs",
    "frontend/postcss.config.js"
  ],
  "include": ["**/*.ts", "**/*.tsx"]
}
